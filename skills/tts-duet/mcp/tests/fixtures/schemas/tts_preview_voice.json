{
  "_meta": {
    "anthropic/maxResultSizeChars": 500000
  },
  "description": "Generate a short audio sample of a single voice for auditioning. Same return shape as ``tts_generate_chunk``.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "model": {
        "type": "string"
      },
      "seconds_hint": {
        "type": [
          "number",
          "null"
        ]
      },
      "text": {
        "type": "string"
      },
      "voice": {
        "type": "string"
      }
    },
    "required": [
      "voice",
      "text",
      "model"
    ],
    "type": "object"
  },
  "name": "tts_preview_voice",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "bits_per_sample": {
        "type": "integer"
      },
      "channels": {
        "type": "integer"
      },
      "input_tokens": {
        "type": "integer"
      },
      "output_tokens": {
        "type": "integer"
      },
      "pcm_base64": {
        "type": "string"
      },
      "sample_rate_hz": {
        "type": "integer"
      }
    },
    "required": [
      "pcm_base64",
      "sample_rate_hz",
      "bits_per_sample",
      "channels",
      "input_tokens",
      "output_tokens"
    ],
    "type": "object"
  }
}
