{
  "description": "Run a generic Gemini text completion. The caller assembles the entire prompt; this tool returns the generated text and token usage.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "max_output_tokens": {
        "default": 8192,
        "type": "integer"
      },
      "model": {
        "type": "string"
      },
      "prompt": {
        "type": "string"
      },
      "temperature": {
        "default": 0.2,
        "type": "number"
      }
    },
    "required": [
      "prompt",
      "model"
    ],
    "type": "object"
  },
  "name": "text.transform",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "input_tokens": {
        "type": "integer"
      },
      "output_tokens": {
        "type": "integer"
      },
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text",
      "input_tokens",
      "output_tokens"
    ],
    "type": "object"
  }
}
