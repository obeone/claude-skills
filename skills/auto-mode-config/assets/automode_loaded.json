// automode_loaded.json — JSONC example showing the wrapper schema for
// runtime examples. The skill strips entries by structure (not string
// match): a node is dropped iff
//
//   isinstance(node, dict) and node.get("__example_only") is True
//   and set(node.keys()) <= {"__example_only", "value"}
//
// A user rule whose plain text contains the literal substring
// `__example_only` survives because it is a string, not a dict.
//
// To use this file as a reference: copy the relevant `value` fields
// into your real `~/.claude/settings.json` and remove the wrapper.
{
  "autoMode": {
    "environment": [
      "$defaults",
      {
        "__example_only": true,
        "value": "Example claim about the user — replace with your own. e.g. 'I work primarily in Python and Rust on macOS.'"
      },
      {
        "__example_only": true,
        "value": "Example claim about the project — replace with your own. e.g. 'This repo contains only my personal notes; nothing here is production-facing.'"
      },
      {
        "__example_only": true,
        "value": "Example trust statement — replace with your own. e.g. 'Network calls in this project go to local services on 127.0.0.1 only.'"
      }
    ],
    "allow": [
      "$defaults",
      {
        "__example_only": true,
        "value": "Bash(git status:*)"
      },
      {
        "__example_only": true,
        "value": "Bash(uv run pytest:*)"
      }
    ],
    "soft_deny": [
      "$defaults",
      {
        "__example_only": true,
        "value": "Bash(rm -rf:*)"
      },
      {
        "__example_only": true,
        "value": "WebFetch(domain:*)"
      }
    ]
  }
}
