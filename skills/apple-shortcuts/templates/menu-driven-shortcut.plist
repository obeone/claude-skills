<!--
  menu-driven-shortcut.plist

  Presents a menu; each branch does something different.
  Demonstrates: Choose from Menu (control flow), branching with
  GroupingIdentifier + WFControlFlowMode, Show Notification per branch.

  Customize:
  - WFMenuPrompt / WFMenuItems: the menu text and items.
  - Actions inside each branch.

  Sign and import:
    mv menu-driven-shortcut.plist menu.shortcut
    shortcuts sign -i menu.shortcut -o menu.signed.shortcut -m anyone
    open -a Shortcuts menu.signed.shortcut
-->
