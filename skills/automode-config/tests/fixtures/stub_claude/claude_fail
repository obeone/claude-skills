#!/bin/sh
# Stub claude CLI: --help advertises --settings, but auto-mode critique exits 1.

case "$1" in
    --version)
        echo "claude 1.42.0"
        exit 0
        ;;
    --help)
        cat <<'EOF'
Usage: claude [options]

Options:
  --version                Show version
  --help                   Show this help
  --settings <path>        Path to settings file
EOF
        exit 0
        ;;
    auto-mode)
        shift
        case "$1" in
            critique)
                shift
                for arg in "$@"; do
                    if [ "$arg" = "--help" ]; then
                        cat <<'EOF'
Usage: claude auto-mode critique [options]

Options:
  --settings <path>        Settings file to critique
  --defaults <path>        Defaults file
  --config <path>          Config file
  --model <name>           Model to use
  --help                   Show this help
EOF
                        exit 0
                    fi
                done
                # Print a critique-ish prelude on stderr but exit non-zero.
                cat >&2 <<'EOF'
# Critique of Custom Rules

## Major issues

1. Simulated failure for testing.

## Smaller issues

EOF
                exit 1
                ;;
        esac
        ;;
esac

exit 0
